{
  "name": "minha-extensao-chrome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "build:content": "vite build --config vite.config.content.js",
    "build:background": "vite build --config vite.config.background.js",
    "merge": "node scripts/mergeDist.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "build": "npm run build:content && npm run build:background && npm run merge"
  },
  "devDependencies": {
    "esbuild": "^0.25.3",
    "jsdom": "^26.1.0",
    "rollup-plugin-visualizer": "^5.14.0",
    "vite": "^6.3.1",
    "vite-plugin-static-copy": "^2.3.1",
    "vitest": "3.1.2",
    "vitest/ui": "3.1.2"
    
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "tree": "^0.1.3"
  }
}
